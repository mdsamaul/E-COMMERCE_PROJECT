# ==============================================================================
# ShopBD Production Environment Configuration Template
# Optimized for Affordable Bangladesh-Compatible cPanel Shared Hosting
# ==============================================================================

APP_NAME=ShopBD
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_YOUR_GENERATED_APP_KEY_DO_NOT_LOSE
APP_DEBUG=false
APP_TIMEZONE=Asia/Dhaka
APP_URL=https://yourdomain.com.bd

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Bangladesh Currency & Shipping Configuration
APP_CURRENCY=BDT
APP_CURRENCY_SYMBOL=৳
SHIPPING_INSIDE_DHAKA=60
SHIPPING_OUTSIDE_DHAKA=120
FREE_SHIPPING_THRESHOLD=2500

# Logging: Daily rotation prevents oversized log files on shared hosting
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# cPanel MySQL Database Configuration
# Note: cPanel automatically prefixes databases and users with your cPanel username
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpaneluser_shopbd
DB_USERNAME=cpaneluser_dbuser
DB_PASSWORD="YourStrongSecurePasswordHere!#99"

# Shared Hosting Storage & Session Drivers
# Note: file or database drivers work seamlessly without Redis on shared hosting
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=public

CACHE_STORE=file
CACHE_PREFIX=shopbd_cache_

QUEUE_CONNECTION=sync

# Email Configuration (cPanel Webmail / SMTP or Brevo/SendGrid)
MAIL_MAILER=smtp
MAIL_HOST=mail.yourdomain.com.bd
MAIL_PORT=465
MAIL_USERNAME=support@yourdomain.com.bd
MAIL_PASSWORD="YourWebmailPasswordHere"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="support@yourdomain.com.bd"
MAIL_FROM_NAME="${APP_NAME}"

# Optional Bangladesh Payment Gateway Integrations
# Gateways remain safely disabled until live credentials are provided
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=false

BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_IS_SANDBOX=false

# Optional Bangladesh Courier Logistics Integrations
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
PATHAO_IS_SANDBOX=false

# Optional Bangladesh SMS Notification Gateways
SMS_PROVIDER=none
SMS_API_KEY=
SMS_SENDER_ID=
